{
  "info": {
    "name": "EV Fleet Booking API",
    "description": "Auth flow first — other modules (vehicles, bookings, wallet, etc.) will be added here as they're converted to TypeScript. Import this alongside the matching environment file, select the environment, and run requests top-to-bottom in the Auth folder: each one feeds tokens into the next automatically via {{access_token}}, {{refresh_token}}, {{test_email}}, {{otp_code}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"testuser+{{$randomInt}}@example.com\",\n  \"phone\": \"08012345678\",\n  \"role\": \"INDIVIDUAL_PARTNER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration accepted', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.email) {",
                  "  pm.environment.set('test_email', body.data.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"code\": \"{{otp_code}}\",\n  \"purpose\": \"REGISTRATION\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// otp_code must be set manually (or read from your email/test inbox) —",
                  "// set it in the environment before running this request.",
                  "pm.test('OTP verified', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/create-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "create-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Password created', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.environment.set('access_token', body.data.accessToken);",
                  "  pm.environment.set('refresh_token', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Access token refreshed', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) {",
                  "  pm.environment.set('access_token', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\"\n}" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"code\": \"{{otp_code}}\",\n  \"password\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Social Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/social-login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "social-login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"GOOGLE\",\n  \"token\": \"<google-id-token>\",\n  \"role\": \"INDIVIDUAL_PARTNER\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/vehicles?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehicles"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Vehicles listed', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Get Vehicle By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicle_id}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehicles", "{{vehicle_id}}"] }
          }
        },
        {
          "name": "Create Vehicle",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/vehicles", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehicles"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tesla Model 3\",\n  \"plate\": \"ABC-123-XY\",\n  \"category\": \"EXECUTIVE\",\n  \"pricePerHour\": 25,\n  \"isElectric\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vehicle created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "  pm.environment.set('vehicle_id', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicle_id}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehicles", "{{vehicle_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"UNAVAILABLE\"\n}" }
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicle_id}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vehicles", "{{vehicle_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "OpenAPI JSON (raw spec)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api-docs.json", "host": ["{{baseUrl}}"], "path": ["api-docs.json"] }
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        }
      ]
    }
  ]
}
